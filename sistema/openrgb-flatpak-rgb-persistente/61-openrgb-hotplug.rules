# Reaplica OpenRGB al reconectar dispositivos por USB (hotplug).
# OpenRGB detecta dispositivos solo al arrancar; sin esto, un teclado/mouse
# reconectado vuelve a su color de fabrica hasta reiniciar el servidor.
#
# IMPORTANTE: udev NO debe ejecutar systemctl directo. Su worker corre en el
# dominio SELinux 'udev_t', muy confinado, y no alcanza el bus del usuario ->
# el restart falla en silencio. En su lugar se etiqueta el device y se deja
# que PID1 arranque openrgb-hotplug.service (contexto sano) via SYSTEMD_WANTS.
#
# Ajustar idVendor/idProduct con `lsusb` (mouse inalambrico = usar el receptor).
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0951", ATTR{idProduct}=="16e6", TAG+="systemd", ENV{SYSTEMD_WANTS}+="openrgb-hotplug.service"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="046d", ATTR{idProduct}=="c539", TAG+="systemd", ENV{SYSTEMD_WANTS}+="openrgb-hotplug.service"
